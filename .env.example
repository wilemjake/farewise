# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Singapore Land Transport Authority (LTA) DataMall API Key
# Sign up at: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"

# OneMap Singapore API Key / Token (Optional for basic search, required for higher quotas)
# Sign up at: https://www.onemap.gov.sg/apidocs/
ONEMAP_API_KEY="YOUR_ONEMAP_API_KEY"
